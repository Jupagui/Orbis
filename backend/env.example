# Entorno de la aplicación
ENVIRONMENT=dev # dev | prod
DEBUG=False # True imprime todas las consultas SQL

# Base de datos (SQLite local; se crea sola al iniciar)
DATABASE_URL=sqlite+aiosqlite:///./orbis.db

# IA (Google Gemini) - clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-3.1-flash-lite

# Mapas (Geoapify) - clave gratuita en https://myprojects.geoapify.com
# Si se deja vacía, ORBIS usa OpenStreetMap (Nominatim, Overpass y OSRM)
GEOAPIFY_API_KEY=

# Imágenes subidas por los usuarios
UPLOADS_DIR=./uploads
IMAGEN_LADO_MAXIMO=1600

# Logging
LOG_LEVEL=INFO
